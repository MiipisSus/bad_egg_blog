generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Member {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  title     String?
  bio       String?
  rank      String?
  image     String?
  nameCard  String?
  type      String   @default("community") // "leader" | "community"
  sortIndex Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryAlbum {
  id          Int            @id @default(autoincrement())
  title       String
  description String?
  date        String?
  images      GalleryImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model GalleryImage {
  id        Int          @id @default(autoincrement())
  path      String
  sortIndex Int          @default(0)
  albumId   Int
  album     GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
}

model Activity {
  id          Int      @id @default(autoincrement())
  image       String
  title       String
  description String?
  sortIndex   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Timeline {
  id        Int      @id @default(autoincrement())
  title     String
  date      String?  // flexible: "2024-03", "2024-03-15", etc.
  image     String?
  sortIndex Int      @default(0)
  createdAt DateTime @default(now())
}

model HeroBanner {
  id        Int      @id @default(autoincrement())
  image     String
  sortIndex Int      @default(0)
  createdAt DateTime @default(now())
}

model StickyNote {
  id        Int      @id @default(autoincrement())
  image     String   // transparent PNG path
  posX      Float    @default(80)
  posY      Float    @default(60)
  zIndex    Int      @default(1)
  page      Int      @default(0)
  author    String?
  color     String   @default("#ffffff")
  visitorId String   // unique visitor fingerprint
  ipAddress String?
  createdAt DateTime @default(now())
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}
